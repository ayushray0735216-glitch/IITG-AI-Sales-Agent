# Merge selected values into your environment; do not overwrite an existing .env.
# Disabled until the shared database/backend and teammate adapter are configured.
INTEGRATION_ENABLED=false
# Production: use the same existing DATABASE_URL as the Streamlit/voice services.
# Local isolated preview only: set a full path to a disposable SQLite database.
INTEGRATION_SQLITE_PATH=
INTEGRATION_PUBLIC_CHAT_URL=http://localhost:8501/
INTEGRATION_PORT=8800
# Separate random values of at least 32 characters. No example credentials here.
INTEGRATION_DISCOVERY_KEY=
INTEGRATION_OUTREACH_KEY=
INTEGRATION_ADMIN_KEY=

# Optional Phase 2 prospect discovery. Put the real key in .env locally or
# Streamlit secrets when hosted. Never paste it into a CRM form or commit it.
APOLLO_API_KEY=
